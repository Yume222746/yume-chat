doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      integrity="sha256-fx038NkLY4U1TCrBDiu5FWPEa9eiZu01EiLryshJbCo="
      crossorigin="anonymous")
    link(rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css")
    link(rel="stylesheet" href="/style.css")
    title プロフィール
  body.container.overflow-scroll(data-bs-theme=currentTheme)
    nav.navbar.fixed-top.bg-primary 
      div.container-fluid
        h1.text-light.navbar-brand.mx-auto 
          a.text-light(href="/posts") yumeチャット
          i.bi-chat-dots-fill.ms-1
        div.dropdown
          button.btn.btn-outline-light.dropdown-toggle(type="button" id="menu" data-bs-toggle="dropdown" aria-expanded="false") #{MyName}
            i.bi-gear-fill.ms-1
          ul.dropdown-menu.dropdown-menu-end(aria-labelledby="menu")
            li 
              - const changeThemeText = (currentTheme === 'light' ? 'ダークモードに切り替え' : 'ライトモードに切り替え');
              a.dropdown-item(href="/changeTheme") #{changeThemeText}
              a.dropdown-item(href=`/profile/${MyName}`) マイページを編集
              a.dropdown-item(href=`/posts`) 投稿一覧へ
              a.dropdown-item(href="/logout") ログアウト
    h1 #{pageUser}の自己紹介
    ul 
      li 自己紹介文
        p #{bio}
      li e-mail
        p #{email}
    - const isEditable = (MyName === pageUser);
    if isEditable
      div.fixed-bottom.p-4.bg-body
        form(method="post" action=`/profile/${MyName}` name="edit-profile-form").container-fluid.row.g-3
          div.col-12
            textarea(name="bio" rows="4" placeholder="ここに自己紹介を入力").form-control
          div.col-12
            textarea(name="e-mail" rows="4" placeholder="ここにメアドを入力").form-control
          div.col-12
            button(type="submit").btn.btn-primary.float-end
              i.bi-send
            input(type="hidden" name="oneTimeToken" value=oneTimeToken)


    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
      integrity="sha256-qlPVgvl+tZTCpcxYJFdHB/m6mDe84wRr+l81VoYPTgQ="
      crossorigin="anonymous")